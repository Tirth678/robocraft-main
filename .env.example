# Neon Lakebase Postgres (pooled URL for application traffic)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[PROJECT]-pooler.[REGION].aws.neon.tech/[DATABASE]?sslmode=require"
# Direct URL for schema migrations only (never use this for normal request traffic).
DATABASE_URL_UNPOOLED="postgresql://[USER]:[PASSWORD]@[PROJECT].[REGION].aws.neon.tech/[DATABASE]?sslmode=require"

# Neon Managed Auth (written by `neon deploy` or `neon env pull`)
NEON_AUTH_BASE_URL=https://your-project.neon.tech/neon-auth
NEON_AUTH_JWKS_URL=https://your-project.neon.tech/neon-auth/.well-known/jwks.json
VITE_NEON_AUTH_URL=https://your-project.neon.tech/neon-auth

# Neon Object Storage (written by `neon env pull --service object-storage`).
# Holds product images and the files behind digital products.
AWS_ACCESS_KEY_ID=your_storage_access_key_id
AWS_SECRET_ACCESS_KEY=your_storage_secret_access_key
AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-6.us-east-2.aws.neon.tech
AWS_REGION=us-east-2

# Private bucket for images + digital deliverables
INVENTORY_STORAGE_BUCKET=productimages
# Public origin of the inventory service; used to build links that land in emails
INVENTORY_PUBLIC_URL=http://localhost:3002

# Shared secret for service-to-service calls (billing -> inventory fulfilment).
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=generate_your_own_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Redis
REDIS_URL=redis://localhost:6379

# Resend
RESEND_API_KEY=your_resend_api_key

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
CART_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3004
EMAIL_SERVICE_URL=http://localhost:3005

# Frontend URLs
CUSTOMER_FRONTEND_URL=http://localhost:8080
# The admin lives in the same official storefront at /admin.
ADMIN_DASHBOARD_URL=http://localhost:8080

# Public browser-to-inventory endpoint. In production this must be the
# deployed inventory service URL (or a reverse-proxy URL), never localhost.
# VITE_INVENTORY_SERVICE_URL=https://api.example.com/inventory

# Node Environment
NODE_ENV=development

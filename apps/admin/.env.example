# Private admin console configuration.
#
# Leave VITE_ADMIN_SERVICE_URL unset in local development so requests go through
# the Vite proxy at /admin-api (see vite.config.ts), which keeps the session
# cookie first-party and avoids CORS entirely.
#
# Set it to the absolute admin-service origin for deployed/static hosting, where
# no dev proxy exists. That origin must also be listed in the service's
# ADMIN_ALLOWED_ORIGINS.
# VITE_ADMIN_SERVICE_URL=http://localhost:3007

# Only needed when the admin console must call non-admin backend services
# directly. Left unset, same-origin relative paths are used.
# VITE_BACKEND_URL=http://localhost:8000
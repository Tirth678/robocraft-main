# Public storefront (Vite). All VITE_* values are inlined at BUILD time, so they
# must be set in the static host's build environment, not just at runtime.
#
# Base URL of the public API gateway (apps/api-gateway, port 8081 locally).
# Requests go to <VITE_BACKEND_URL>/api/* and are proxied to the internal
# cart, billing, auth and inventory services.
VITE_BACKEND_URL=http://localhost:8081

# Neon Auth (Better Auth) base URL, used for customer sign-in and sessions.
VITE_NEON_AUTH_URL=http://localhost:3001/auth

# Optional. Only needed if the storefront talks to inventory-service directly
# instead of going through the gateway. Leave empty to use the gateway.
VITE_INVENTORY_SERVICE_URL=

# Optional. Direct admin-service base URL. The admin console is a separate,
# private origin in production, so this is normally left empty.
VITE_ADMIN_SERVICE_URL=

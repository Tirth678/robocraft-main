# Copy to deploy/aws/backend.env and fill in, then run ./deploy/aws/deploy.sh.
# deploy.sh uploads this file to /srv/robocraft/backend.env and never commits it.
#
# Because all seven services run in ONE container (scripts/start-backend.sh),
# their internal URLs default to localhost:300x and must NOT be set here. Only
# PORT is supplied by compose; everything below is what the processes read.

# ---------------------------------------------------------------- origins
# These are CORS allow-lists and email deep-link targets, so they must name the
# deployed frontends exactly (scheme + host, no trailing slash).
CUSTOMER_FRONTEND_URL=https://robocraft-web.vercel.app
ADMIN_DASHBOARD_URL=https://robocraft-admin.vercel.app
ADMIN_ALLOWED_ORIGINS=https://robocraft-admin.vercel.app
# HTTPS via Caddy, so the admin session cookie must be Secure.
ADMIN_COOKIE_SECURE=true
ADMIN_EMAILS=admin@robocraft.com,tirth@robocraft.com

# ---------------------------------------------------------------- database
# Pooled Neon URL for the services; the unpooled one is only for migrations.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------ Neon Auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# ------------------------------------------- object storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
INVENTORY_STORAGE_BUCKET=productimages
# Digital-delivery links resolve through the public gateway origin.
INVENTORY_PUBLIC_URL=https://robocraft-<dashed-ip>.sslip.io/inventory

# ------------------------------------------------------------------ email
RESEND_API_KEY=
EMAIL_FROM=RoboCraft <onboarding@resend.dev>
# Leave unset in production; it funnels every message to one inbox.
# EMAIL_REDIRECT_TO=

# --------------------------------------------------------------- internal
# Shared HMAC for service-to-service calls. Generate with:
#   openssl rand -hex 32
INTERNAL_SERVICE_SECRET=

# ------------------------------------------------------------ superadmin fix
# Set both once to seed the first staff row, then delete them.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# --------------------------------------------------------------- payments
# Unset = mock mode (orders settle without charging). Set all three to go live;
# RAZORPAY_WEBHOOK_SECRET is the per-endpoint secret, not the API key secret.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

// use prisma-8

// Commerce user profiles linked to Neon Managed Auth identities in neon_auth.user.
model User {
  id        String   @id @default(uuid())
  authUserId String  @unique
  email     String
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  orders    Order[]

  @@map("users")
}

// Categories table
model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@map("categories")
}

// Products table
model Product {
  id          String    @id @default(uuid())
  name        String
  description String
  price       Float
  stock       Int       @default(0)
  images      Json
  categoryId  String
  discountId  String?
  isActive    Boolean   @default(true)
  category    Category  @relation(fields: [categoryId], references: [id])
  discount    Discount? @relation(fields: [discountId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@map("products")
}

// Discounts table
model Discount {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String
  value       Float
  minPurchase Float?
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@map("discounts")
}

// Orders table
model Order {
  id               String      @id @default(uuid())
  userId           String
  status           String
  total            Float
  razorpayOrderId  String?     @unique
  razorpayPaymentId String?
  user             User        @relation(fields: [userId], references: [id])
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now())

  @@map("orders")
}

// Order items table
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// Pre-orders table
model PreOrder {
  id            String   @id @default(uuid())
  userId        String
  productId     String
  quantity      Int      @default(1)
  status        String   @default("pending")
  customerEmail String
  customerName  String?
  customerPhone String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@map("pre_orders")
}

// Inventory items table - matches the inventory service expectations
model InventoryItem {
  id               String   @id @default(uuid())
  sku              String   @unique
  name             String
  description      String?
  category         String?
  imageKeys        Json     @default("[]") @map("image_keys")
  mrpMinor         Int?     @map("mrp_minor")
  salePriceMinor   Int?     @map("sale_price_minor")
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("inventory_items")
}

// Inventory stock movements table
model InventoryStockMovement {
  id               String   @id @default(uuid())
  itemId           String   @map("item_id")
  quantityDelta    Int      @map("quantity_delta")
  quantityBefore   Int      @map("quantity_before")
  quantityAfter    Int      @map("quantity_after")
  reason           String
  idempotencyKey   String   @unique @map("idempotency_key")
  performedBy      String   @map("performed_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("inventory_stock_movements")
}

// Inventory admins table - for admin authentication
model InventoryAdmin {
  id         String    @id @default(uuid())
  authUserId String    @unique @map("auth_user_id")
  email      String
  role       String    @default("admin")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("inventory_admins")
}

// Analytics table
model Analytics {
  id              String    @id @default(uuid())
  date            DateTime  @unique
  revenue         Float   @default(0)
  orders          Int       @default(0)
  pageViews       Int       @default(0)
  uniqueVisitors  Int       @default(0)
  conversionRate  Float   @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  @@map("analytics")
}

{
  "name": "billing-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "database": "*",
    "elysia": "^1.0.0",
    "pg": "^8.23.0",
    "razorpay": "^2.8.6",
    "shared-types": "*",
    "shared-utils": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.4.5",
    "eslint": "^8.57.0"
  }
}

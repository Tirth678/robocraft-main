{
  "name": "inventory-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "admin:grant": "bun run src/grant-admin.ts",
    "db:migrate": "bun --env-file=../../.env run src/migrate.ts",
    "smoke:digital": "bun --env-file=../../.env run src/__smoke__/digital.smoke.ts",
    "smoke:storage": "bun --env-file=../../.env run src/__smoke__/storage.smoke.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "aws4fetch": "^1.0.20",
    "database": "*",
    "elysia": "^1.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "shared-types": "*",
    "shared-utils": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.4.5",
    "eslint": "^8.57.0"
  }
}
